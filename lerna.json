{
  "$schema": "node_modules/lerna/schemas/lerna-schema.json",
  "npmClient": "pnpm",
  "version": "2.0.68",
  "command": {
    "version": {
      "allowBranch": "main",
      "conventionalCommits": false,
      "message": "chore(release): publish %s",
      "tagVersionPrefix": "v"
    },
    "publish": {
      "registry": "https://registry.npmjs.org/",
      "access": "public"
    }
  }
}