{
  "name": "@nosana/api",
  "version": "2.7.4",
  "description": "Nosana API module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "author": "Nosana",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nosana-ci/nosana-kit.git",
    "directory": "packages/api"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "build:with-deps": "pnpm --filter $npm_package_name... run build",
    "dev": "tsc --watch",
    "dev:with-deps": "pnpm --filter $npm_package_name... --parallel run dev",
    "clean": "rm -rf dist",
    "generate:types:blockchain-indexer": "openapi-typescript ${BLOCKCHAIN_INDEXER_URL:-http://localhost:3003}/swagger/json -o src/client/blockchain-indexer/schema.ts",
    "generate:types:deployment-manager": "openapi-typescript ${DEPLOYMENT_MANAGER_URL:-http://localhost:3001}/documentation/json -o src/client/deployment-manager/schema.ts",
    "generate:types:host-manager": "openapi-typescript ${HOST_MANAGER_URL:-http://localhost:3004}/swagger/json -o src/client/host-manager/schema.ts",
    "generate:types:client-manager": "openapi-typescript ${CLIENT_MANAGER_URL:-http://localhost:3002}/swagger/json -o src/client/client-manager/schema.ts",
    "generate:types": "pnpm generate:types:blockchain-indexer && pnpm generate:types:deployment-manager && pnpm generate:types:host-manager && pnpm generate:types:client-manager",
    "generate:types:blockchain-indexer:dev": "openapi-typescript https://blockchain-indexer.k8s.dev.nos.ci/swagger/json -o src/client/blockchain-indexer/schema.ts",
    "generate:types:blockchain-indexer:prd": "openapi-typescript https://blockchain-indexer.k8s.prd.nos.ci/swagger/json -o src/client/blockchain-indexer/schema.ts",
    "generate:types:deployment-manager:dev": "openapi-typescript https://deployment-manager.k8s.dev.nos.ci/documentation/json -o src/client/deployment-manager/schema.ts",
    "generate:types:deployment-manager:prd": "openapi-typescript https://deployment-manager.k8s.prd.nos.ci/documentation/json -o src/client/deployment-manager/schema.ts",
    "generate:types:host-manager:dev": "openapi-typescript https://host-manager.k8s.dev.nos.ci/swagger/json -o src/client/host-manager/schema.ts",
    "generate:types:host-manager:prd": "openapi-typescript https://host-manager.k8s.prd.nos.ci/swagger/json -o src/client/host-manager/schema.ts",
    "generate:types:client-manager:dev": "openapi-typescript https://client-manager.k8s.dev.nos.ci/swagger/json -o src/client/client-manager/schema.ts",
    "generate:types:client-manager:prd": "openapi-typescript https://client-manager.k8s.prd.nos.ci/swagger/json -o src/client/client-manager/schema.ts",
    "generate:types:dev": "pnpm generate:types:blockchain-indexer:dev && pnpm generate:types:deployment-manager:dev && pnpm generate:types:host-manager:dev && pnpm generate:types:client-manager:dev",
    "generate:types:prd": "pnpm generate:types:blockchain-indexer:prd && pnpm generate:types:deployment-manager:prd && pnpm generate:types:host-manager:prd && pnpm generate:types:client-manager:prd",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "format": "echo 'No format' && exit 0",
    "format:fix": "echo 'No format:fix' && exit 0"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitest/coverage-v8": "^4.0.3",
    "eslint": "^9.31.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "openapi-typescript": "^7.8.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.3"
  },
  "dependencies": {
    "@nosana/types": "workspace:*",
    "openapi-fetch": "^0.14.0"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.18.0"
  }
}
