# Copy to `.env` and fill in.

# Client ID of a Browser app you created in the Nosana dashboard
# (Account → Connected Apps) whose redirect URL is http://localhost:3000
VITE_NOSANA_CLIENT_ID=stcl_

# Which Nosana network your app is registered on: mainnet (default) or devnet.
# The kit picks the matching auth + API endpoints from this.
VITE_NOSANA_NETWORK=devnet
