{
  "name": "@nosana/localnet",
  "version": "2.7.2",
  "description": "Nosana localnet: Solana test validator with pre-baked Nosana programs + localnet test helpers",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "build:with-deps": "pnpm run build",
    "dev": "tsc --watch",
    "dev:with-deps": "pnpm run dev",
    "test": "echo 'No tests' && exit 0",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "format": "prettier --config ../../.prettierrc --ignore-path ../../.prettierignore --check \"**/*.ts\"",
    "format:fix": "prettier --config ../../.prettierrc --ignore-path ../../.prettierignore --write \"**/*.ts\""
  },
  "keywords": [
    "nosana",
    "solana",
    "localnet",
    "testing",
    "test-validator"
  ],
  "author": "Nosana",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nosana-ci/nosana-kit.git",
    "directory": "packages/localnet"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "vitest": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.18.0"
  },
  "files": [
    "dist",
    "docker",
    "fixtures",
    "keys",
    "Dockerfile",
    "package.json",
    "README.md"
  ]
}
