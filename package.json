{
  "name": "@nosana/workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:packages": "pnpm --filter \"./packages/**\" run build",
    "dev": "pnpm -r run dev --parallel",
    "test": "pnpm -r run test",
    "test:localnet": "docker compose -f docker-compose.localnet.yml up -d --wait --force-recreate && NODE_NO_WARNINGS=1 vitest run --config vitest.localnet.config.ts",
    "test:localnet:down": "docker compose -f docker-compose.localnet.yml down -v && docker run --rm -v \"$(pwd)/localnet\":/data alpine sh -c \"rm -rf /data/ledger /data/fixtures\"",
    "test:localnet:logs": "docker compose -f docker-compose.localnet.yml logs -f",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format",
    "format:fix": "pnpm -r run format:fix",
    "generate-clients": "pnpm exec tsx scripts/generate-clients.ts",
    "version": "true",
    "version:patch": "lerna version patch --yes",
    "version:force": "lerna version patch --yes --force-publish",
    "publish": "lerna publish from-git --yes"
  },
  "devDependencies": {
    "@codama/node-types": "^1.5.0",
    "@codama/nodes-from-anchor": "^1.3.8",
    "@codama/renderers-js": "^1.5.5",
    "@codama/visitors-core": "^1.5.0",
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "codama": "^1.5.0",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "lerna": "^9.0.4",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}