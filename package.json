{
  "name": "@nosana/kit",
  "version": "0.0.0",
  "description": "Nosana KIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "NODE_NO_WARNINGS=1 vitest run",
    "test:coverage": "NODE_NO_WARNINGS=1 vitest run --coverage",
    "test:watch": "NODE_NO_WARNINGS=1 vitest",
    "generate-clients": "pnpm dlx tsx scripts/generate-clients.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"**/*.ts\"",
    "format:fix": "prettier --write \"**/*.ts\"",
    "publish:public": "pnpm run build && pnpm publish --access public",
    "docs:dev": "pnpm --filter @nosana/docs dev",
    "docs:build": "pnpm --filter @nosana/docs build",
    "docs:preview": "pnpm --filter @nosana/docs preview"
  },
  "keywords": [
    "nosana",
    "solana",
    "sdk",
    "kit",
    "blockchain"
  ],
  "author": "Nosana",
  "license": "MIT",
  "dependencies": {
    "@nosana/api": "^0.1.7",
    "@nosana/authorization": "^0.1.7",
    "@nosana/endpoints": "^1.0.0",
    "@nosana/ipfs": "^0.1.2",
    "@nosana/types": "^0.1.13",
    "@solana-program/compute-budget": "0.12.0",
    "@solana-program/system": "0.10.0",
    "@solana-program/token": "0.9.0",
    "@solana/kit": "5.4.0",
    "bs58": "6.0.0"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.3.8",
    "@codama/renderers-js": "^1.5.5",
    "@codama/visitors-core": "^1.5.0",
    "@eslint/js": "^9.39.2",
    "@nosana/kit": "file:.",
    "@prettier/sync": "^0.6.1",
    "@types/node": "^20.19.27",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitest/coverage-v8": "^4.0.16",
    "codama": "^1.5.0",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.7.4",
    "sass-embedded": "^1.97.2",
    "ts-node": "^10.9.2",
    "typedoc": "0.28.16",
    "typedoc-plugin-frontmatter": "^1.3.1",
    "typedoc-plugin-markdown": "^4.9.0",
    "typedoc-plugin-mdn-links": "^5.0.10",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "ws": "^8.18.0"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.18.0"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ]
}