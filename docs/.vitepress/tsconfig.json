{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "noEmit": true,
    "strict": true,
    "types": ["node"],
    "typeRoots": ["../../node_modules/@types", "../../node_modules", "../node_modules/@types", "../node_modules"]
  },
  "include": [
    "../../dist/**/*.d.ts",
    "**/*.ts",
    "**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "../../node_modules",
    "../../tests",
    "../../src"
  ]
}
