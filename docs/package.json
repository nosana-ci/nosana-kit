{
  "name": "@nosana/docs",
  "version": "2.5.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vitepress dev .",
    "build": "pnpm run api && NODE_OPTIONS='--max-old-space-size=4096' vitepress build .",
    "build:with-deps": "pnpm --filter $npm_package_name... run build",
    "dev:with-deps": "pnpm --filter $npm_package_name... run dev --parallel",
    "api": "cd .. && pnpm --filter @nosana/kit exec typedoc",
    "preview": "vitepress preview .",
    "test": "echo 'No tests' && exit 0",
    "lint": "echo 'No lint' && exit 0",
    "format": "echo 'No format' && exit 0",
    "format:fix": "echo 'No format:fix' && exit 0"
  },
  "dependencies": {
    "@nosana/kit": "workspace:*"
  },
  "devDependencies": {
    "@braintree/sanitize-url": "^7.0.0",
    "@shikijs/twoslash": "^3.20.0",
    "@shikijs/vitepress-twoslash": "^3.20.0",
    "@solana-program/system": "0.10.0",
    "@solana/kit": "5.4.0",
    "@vue/repl": "^4.0.0",
    "chart.js": "^4.5.1",
    "cytoscape": "^3.32.0",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dayjs": "^1.11.19",
    "debug": "^4.4.3",
    "floating-vue": "^5.2.2",
    "markdown-it-container": "^4.0.0",
    "markdown-it-mathjax3": "^5.0.0",
    "mermaid": "^11.0.0",
    "typescript": "^5.9.3",
    "vitepress": "^2.0.0-alpha.15",
    "vitepress-plugin-glossary": "^1.0.6",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitepress-plugin-tabs": "^0.7.3"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "overrides": {
    "shiki": "^3.15.0",
    "vitepress-plugin-mermaid": {
      "vitepress": "^2.0.0-alpha.15"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nosana-ci/nosana-kit.git",
    "directory": "docs"
  },
  "license": "MIT",
  "author": "Nosana"
}
